    "test": "node scripts/run-tests.mjs",
    "lint:engraving": "tsx scripts/lint_engraving.ts",
    "pdf": "tsx scripts/export-pdf.ts",
    "brahms:export-durations": "tsx scripts/brahms-export-written-durations.ts",
    "brahms:export-expressions": "tsx scripts/brahms-export-expressions.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28"
  }
