{
  "name": "iso-notation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Presentation-agnostic lossless 12-TET music notation system and deterministic vector visualization workbench for 4-row Jánko isomorphic keyboards.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5175",
